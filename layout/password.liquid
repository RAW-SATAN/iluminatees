<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Coming Soon</title>
  {{ content_for_header }}
  {{ 'banani.css' | asset_url | stylesheet_tag }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Space Grotesk',sans-serif;background:#003d35;color:#fff;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px}
    .pw-logo{font-family:'Bebas Neue',sans-serif;font-size:2.5rem;letter-spacing:.2em;color:#fff;margin-bottom:8px}
    .pw-tagline{font-size:.85rem;letter-spacing:.15em;color:rgba(255,255,255,.6);text-transform:uppercase;margin-bottom:48px}
    .pw-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(2.5rem,8vw,5rem);letter-spacing:.05em;margin-bottom:16px}
    .pw-subtitle{font-size:1rem;color:rgba(255,255,255,.7);margin-bottom:48px;max-width:480px}
    .pw-form{display:flex;gap:0;width:100%;max-width:400px;margin-bottom:32px}
    .pw-input{flex:1;padding:14px 16px;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.08);color:#fff;font-family:inherit;font-size:.9rem;outline:none}
    .pw-input::placeholder{color:rgba(255,255,255,.4)}
    .pw-btn{padding:14px 24px;background:#e31837;color:#fff;border:none;font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:.1em;cursor:pointer;white-space:nowrap}
    .pw-btn:hover{background:#c01030}
    .pw-admin{position:fixed;bottom:20px;right:20px;font-size:.75rem;color:rgba(255,255,255,.4)}
    .pw-admin a{color:rgba(255,255,255,.4);text-decoration:underline}
  </style>
</head>
<body>
  <p class="pw-logo">{{ shop.name }}</p>
  <p class="pw-tagline">Luxury fashion &amp; lifestyle</p>
  <h1 class="pw-title">Something beautiful<br>is coming</h1>
  <p class="pw-subtitle">We're crafting something extraordinary. Enter the password to get an early preview.</p>

  {% form 'storefront_password' %}
    {%- if form.errors -%}
      <p style="color:#ff6b6b;margin-bottom:12px;font-size:.85rem">{{ 'password.general.login_form.incorrect_password_error' | t }}</p>
    {%- endif -%}
    <div class="pw-form">
      <input
        type="password"
        name="password"
        id="password"
        class="pw-input"
        placeholder="Enter password"
        autocomplete="current-password"
      >
      <button type="submit" class="pw-btn">Enter</button>
    </div>
  {% endform %}

  <p class="pw-admin">
    <a href="/admin" target="_blank">Store admin →</a>
  </p>

  {{ content_for_layout }}
</body>
</html>
