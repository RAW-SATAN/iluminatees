{% comment %} 404 Not Found page {% endcomment %}

<div class="error-page">
  <div class="error-page__inner">
    <p class="error-page__code">404</p>
    <h1 class="error-page__title">{{ section.settings.heading | default: 'Page not found' }}</h1>
    <p class="error-page__msg">{{ section.settings.message | default: "Sorry, we couldn't find the page you're looking for." }}</p>

    <div class="error-page__actions">
      <a href="{{ section.settings.btn1_url | default: '/' }}" class="error-page__btn error-page__btn--primary">
        {{ section.settings.btn1_label | default: 'Go back home' }}
      </a>
      <a href="{{ section.settings.btn2_url | default: '/collections/all' }}" class="error-page__btn error-page__btn--outline">
        {{ section.settings.btn2_label | default: 'Shop all' }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section-404",
  "settings": [
    {
      "type": "text", "id": "heading",
      "label": "Heading", "default": "Page not found"
    },
    {
      "type": "textarea", "id": "message",
      "label": "Message",
      "default": "Sorry, we couldn't find the page you're looking for."
    },
    {
      "type": "header", "content": "Button 1 (primary)"
    },
    {
      "type": "text", "id": "btn1_label",
      "label": "Label", "default": "Go back home"
    },
    {
      "type": "url", "id": "btn1_url",
      "label": "Link"
    },
    {
      "type": "header", "content": "Button 2 (outline)"
    },
    {
      "type": "text", "id": "btn2_label",
      "label": "Label", "default": "Shop all"
    },
    {
      "type": "url", "id": "btn2_url",
      "label": "Link"
    }
  ],
  "presets": [{ "name": "404 Page" }]
}
{% endschema %}
