<div class="promo-banner">
  <div class="promo-banner__card">
    <h2 class="promo-banner__title">{{ section.settings.title }}</h2>
    <p class="promo-banner__desc">
      {{ section.settings.desc_prefix }}
      <strong>{{ section.settings.code }}</strong>
      {{ section.settings.desc_suffix }}
    </p>
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="promo-banner__cta">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "section-promo-banner",
  "settings": [
    { "type": "text",  "id": "title",        "label": "Title",          "default": "MOTHER'S DAY SPECIAL" },
    { "type": "text",  "id": "desc_prefix",  "label": "Text before code","default": "Use code" },
    { "type": "text",  "id": "code",         "label": "Discount code",  "default": "LUXE15" },
    { "type": "text",  "id": "desc_suffix",  "label": "Text after code", "default": "for an additional 15% off on gifts & more" },
    { "type": "text",  "id": "cta_label",    "label": "CTA label",      "default": "Shop Now" },
    { "type": "url",   "id": "link",         "label": "CTA link" },
    { "type": "color", "id": "bg_from",      "label": "Gradient start", "default": "#d0e8f5" },
    { "type": "color", "id": "bg_to",        "label": "Gradient end",   "default": "#e8f5e0" },
    { "type": "color", "id": "border_color", "label": "Border color",   "default": "#1a2f6e" },
    { "type": "color", "id": "title_color",  "label": "Title color",    "default": "#1a2f6e" }
  ],
  "presets": [{ "name": "Promo Banner" }]
}
{% endschema %}
