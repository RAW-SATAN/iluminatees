{% comment %} Cart Page {% endcomment %}

<div class="cart-page">
  <div class="cart-page__inner">

    <h1 class="cart-page__heading">MY BAG <span class="cart-page__count">({{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }})</span></h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm">
        <div class="cart-page__layout">

          {%- comment -%} Items {%- endcomment -%}
          <div class="cart-page__items">
            {%- for item in cart.items -%}
              <div class="cart-item" id="CartItem-{{ item.index }}">
                <a href="{{ item.url }}" class="cart-item__img-link">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" class="cart-item__img" loading="lazy">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'cart-item__img-placeholder' }}
                  {%- endif -%}
                </a>
                <div class="cart-item__details">
                  <div class="cart-item__top">
                    <div>
                      <p class="cart-item__vendor">{{ item.vendor | upcase }}</p>
                      <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                      {%- unless item.variant.title == 'Default Title' -%}
                        <p class="cart-item__variant">{{ item.variant.title }}</p>
                      {%- endunless -%}
                    </div>
                    <p class="cart-item__price">{{ item.final_line_price | money }}</p>
                  </div>

                  <div class="cart-item__bottom">
                    <div class="cart-item__qty-wrap">
                      <button type="button" class="cart-item__qty-btn" data-action="minus" data-index="{{ item.index }}" aria-label="Decrease">−</button>
                      <input
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        max="99"
                        class="cart-item__qty-input"
                        id="CartQty-{{ item.index }}"
                        data-index="{{ item.index }}"
                        aria-label="Quantity"
                      >
                      <button type="button" class="cart-item__qty-btn" data-action="plus" data-index="{{ item.index }}" aria-label="Increase">+</button>
                    </div>
                    <button
                      type="button"
                      class="cart-item__remove"
                      data-index="{{ item.index }}"
                      data-key="{{ item.key }}"
                      aria-label="Remove item"
                    >
                      <svg viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      REMOVE
                    </button>
                  </div>

                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    {%- for discount in item.line_level_discount_allocations -%}
                      <p class="cart-item__discount">🏷 {{ discount.discount_application.title }}: -{{ discount.amount | money }}</p>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}

            <div class="cart-page__promo">
              <input type="text" class="cart-page__coupon-input" id="CartCoupon" placeholder="Enter coupon code">
              <button type="button" class="cart-page__coupon-btn" id="CartCouponApply">APPLY</button>
            </div>
          </div>

          {%- comment -%} Summary {%- endcomment -%}
          <div class="cart-page__summary">
            <h2 class="cart-page__summary-title">ORDER SUMMARY</h2>

            <div class="cart-page__summary-rows">
              <div class="cart-page__summary-row">
                <span>Subtotal ({{ cart.item_count }} items)</span>
                <span>{{ cart.original_total_price | money }}</span>
              </div>
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                {%- for discount in cart.cart_level_discount_applications -%}
                  <div class="cart-page__summary-row cart-page__summary-row--discount">
                    <span>🏷 {{ discount.title }}</span>
                    <span>−{{ discount.total_allocated_amount | money }}</span>
                  </div>
                {%- endfor -%}
              {%- endif -%}
              <div class="cart-page__summary-row">
                <span>Shipping</span>
                <span class="cart-page__free-ship">
                  {%- if cart.original_total_price >= 99900 -%}FREE{%- else -%}Calculated at checkout{%- endif -%}
                </span>
              </div>
              {%- if cart.original_total_price < 99900 -%}
                {%- assign remaining = 99900 | minus: cart.original_total_price -%}
                <p class="cart-page__ship-nudge">Add {{ remaining | money }} more for <strong>FREE shipping</strong></p>
              {%- endif -%}
            </div>

            <div class="cart-page__total-row">
              <span>Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-page__tax-note">Inclusive of all taxes</p>

            <button type="submit" name="checkout" class="cart-page__checkout-btn">
              PROCEED TO CHECKOUT →
            </button>
            <a href="/collections/all" class="cart-page__continue">← Continue Shopping</a>

            <div class="cart-page__trust">
              <div class="cart-page__trust-item">
                <svg viewBox="0 0 20 20" fill="none"><path d="M10 2l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 14.27l-4.77 2.44.91-5.32L2.27 7.62l5.34-.78z" stroke="currentColor" stroke-width="1.3"/></svg>
                100% Authentic
              </div>
              <div class="cart-page__trust-item">
                <svg viewBox="0 0 20 20" fill="none"><path d="M10 17s-7-4.5-7-9a7 7 0 0114 0c0 4.5-7 9-7 9z" stroke="currentColor" stroke-width="1.3"/></svg>
                Secure Payment
              </div>
              <div class="cart-page__trust-item">
                <svg viewBox="0 0 20 20" fill="none"><path d="M3 8l7-6 7 6v9a1 1 0 01-1 1H4a1 1 0 01-1-1V8z" stroke="currentColor" stroke-width="1.3"/></svg>
                Easy Returns
              </div>
            </div>
          </div>

        </div>
      </form>

    {%- else -%}
      <div class="cart-page__empty">
        <div class="cart-page__empty-icon">🛍</div>
        <h2 class="cart-page__empty-title">Your bag is empty</h2>
        <p class="cart-page__empty-sub">Looks like you haven't added anything yet.</p>
        <a href="/collections/all" class="cart-page__empty-btn">START SHOPPING</a>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
(function () {
  // Qty +/- buttons
  document.querySelectorAll('.cart-item__qty-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var idx   = btn.dataset.index;
      var input = document.getElementById('CartQty-' + idx);
      if (!input) return;
      var val = parseInt(input.value) || 1;
      input.value = btn.dataset.action === 'plus' ? val + 1 : Math.max(0, val - 1);
    });
  });

  // Remove item via AJAX
  document.querySelectorAll('.cart-item__remove').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.dataset.key;
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: 0 })
      }).then(function () { window.location.reload(); });
    });
  });

  // Coupon (Shopify handles discount codes at checkout — show message)
  var couponBtn = document.getElementById('CartCouponApply');
  if (couponBtn) {
    couponBtn.addEventListener('click', function () {
      var code = document.getElementById('CartCoupon').value.trim();
      if (code) {
        window.location.href = '/checkout?discount=' + encodeURIComponent(code);
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "class": "section-cart-page",
  "settings": [],
  "presets": [{ "name": "Cart Page" }]
}
{% endschema %}
