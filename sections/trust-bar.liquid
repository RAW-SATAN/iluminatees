<div class="trust-bar">
  <div class="trust-bar__inner">
    {%- for block in section.blocks -%}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        <div class="trust-bar__icon">
          {%- if block.settings.icon_svg != blank -%}
            {{ block.settings.icon_svg }}
          {%- else -%}
            {%- case block.settings.icon_preset -%}
              {%- when 'authentic' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M24 4l4 8 9 1.3-6.5 6.3 1.5 9L24 24l-8 4.6 1.5-9L11 13.3l9-1.3z"/>
                  <polyline points="16 24 21 29 32 18"/>
                </svg>
              {%- when 'exchange' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 18h36M6 30h36M18 6l-6 12M36 6l-6 12M18 42l-6-12M36 42l-6-12"/>
                  <rect x="8" y="18" width="32" height="12" rx="2"/>
                </svg>
              {%- when 'quality' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="24" cy="24" r="18"/>
                  <polyline points="16 24 21 29 32 18"/>
                </svg>
              {%- when 'price' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="24" cy="24" r="18"/>
                  <text x="24" y="30" text-anchor="middle" font-size="18" stroke="none" fill="currentColor">₹</text>
                </svg>
              {%- when 'cod' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="12" width="40" height="28" rx="3"/>
                  <path d="M4 20h40"/>
                  <rect x="10" y="28" width="8" height="5" rx="1"/>
                </svg>
              {%- when 'curated' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="24" cy="14" r="8"/>
                  <path d="M14 38c0-5.5 4.5-10 10-10s10 4.5 10 10"/>
                  <path d="M30 22l4 4-4 4"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><circle cx="24" cy="24" r="18"/></svg>
            {%- endcase -%}
          {%- endif -%}
        </div>
        <p class="trust-bar__label">{{ block.settings.label }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "section-trust-bar",
  "settings": [
    { "type": "color", "id": "bg_color",   "label": "Background",  "default": "#ffffff" },
    { "type": "color", "id": "icon_color", "label": "Icon color",  "default": "#333333" },
    { "type": "color", "id": "text_color", "label": "Label color", "default": "#333333" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "select", "id": "icon_preset", "label": "Icon",
          "options": [
            { "value": "authentic", "label": "100% Authentic" },
            { "value": "exchange",  "label": "Easy Exchange" },
            { "value": "quality",   "label": "Assured Quality" },
            { "value": "price",     "label": "Fair Price" },
            { "value": "cod",       "label": "Cash on Delivery" },
            { "value": "curated",   "label": "Curated" },
            { "value": "custom",    "label": "Custom SVG" }
          ],
          "default": "authentic"
        },
        { "type": "html", "id": "icon_svg", "label": "Custom SVG (overrides icon above)" },
        { "type": "text", "id": "label",    "label": "Label", "default": "100% AUTHENTIC" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "usp", "settings": { "icon_preset": "authentic", "label": "100% AUTHENTIC" } },
        { "type": "usp", "settings": { "icon_preset": "exchange",  "label": "EASY EXCHANGE & RETURNS" } },
        { "type": "usp", "settings": { "icon_preset": "quality",   "label": "ASSURED QUALITY" } },
        { "type": "usp", "settings": { "icon_preset": "price",     "label": "FAIR PRICE" } },
        { "type": "usp", "settings": { "icon_preset": "cod",       "label": "CASH ON DELIVERY" } },
        { "type": "usp", "settings": { "icon_preset": "curated",   "label": "CURATED FOR YOU" } }
      ]
    }
  ]
}
{% endschema %}
