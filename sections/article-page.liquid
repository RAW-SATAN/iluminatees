{% comment %} Single article / blog post page {% endcomment %}

<div class="article-page">
  <div class="article-page__inner">

    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep">/</span>
      <a href="{{ blog.url }}" class="breadcrumb__link">{{ blog.title }}</a>
      <span class="breadcrumb__sep">/</span>
      <span class="breadcrumb__current">{{ article.title }}</span>
    </nav>

    {%- if article.tags.size > 0 -%}
      <div class="article-page__tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="article-page__tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <h1 class="article-page__title">{{ article.title }}</h1>

    <div class="article-page__meta">
      {%- if section.settings.show_author -%}
        <span class="article-page__author">By {{ article.author }}</span>
      {%- endif -%}
      {%- if section.settings.show_date -%}
        <time class="article-page__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>
      {%- endif -%}
    </div>

    {%- if article.image != blank -%}
      <div class="article-page__hero" style="aspect-ratio:16/9">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          class="article-page__hero-img"
          loading="eager"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
        >
      </div>
    {%- endif -%}

    <div class="article-page__content rte">
      {{ article.content }}
    </div>

    {%- if section.settings.show_tags and article.tags.size > 0 -%}
      <div class="article-page__footer-tags">
        <span class="article-page__tags-label">Tags:</span>
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="article-page__tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_share_buttons -%}
      <div class="article-page__share">
        <span class="article-page__share-label">Share:</span>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener" class="article-page__share-btn" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://twitter.com/intent/tweet?url={{ shop.url | append: article.url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" class="article-page__share-btn" aria-label="Share on Twitter">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
        </a>
        <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener" class="article-page__share-btn" aria-label="Share on WhatsApp">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.show_related -%}
      {%- assign related = blog.articles | where: 'id', article.id | map: 'id' -%}
      <div class="article-page__related">
        <h2 class="article-page__related-title">More articles</h2>
        <div class="article-page__related-grid">
          {%- assign count = 0 -%}
          {%- for a in blog.articles -%}
            {%- if a.id != article.id and count < section.settings.related_count -%}
              {%- assign count = count | plus: 1 -%}
              <a href="{{ a.url }}" class="related-card">
                {%- if a.image != blank -%}
                  <div class="related-card__img-wrap">
                    <img src="{{ a.image | image_url: width: 400 }}" alt="{{ a.title | escape }}" class="related-card__img" loading="lazy">
                  </div>
                {%- endif -%}
                <p class="related-card__title">{{ a.title }}</p>
                <p class="related-card__date">{{ a.published_at | date: '%b %d, %Y' }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if blog.comments_enabled? -%}
      <div class="article-page__comments">
        {%- if article.comments_count > 0 -%}
          <h2 class="article-page__comments-title">{{ article.comments_count }} comment{% if article.comments_count != 1 %}s{% endif %}</h2>
          {%- paginate article.comments by 10 -%}
            {%- for comment in article.comments -%}
              <div class="article-comment" id="comment-{{ comment.id }}">
                <div class="article-comment__header">
                  <strong class="article-comment__author">{{ comment.author }}</strong>
                  <time class="article-comment__date">{{ comment.created_at | date: '%b %d, %Y' }}</time>
                </div>
                <div class="article-comment__body">{{ comment.content }}</div>
              </div>
            {%- endfor -%}
          {%- endpaginate -%}
        {%- endif -%}

        <div class="article-page__comment-form">
          <h3 class="article-page__comment-form-title">Leave a comment</h3>
          {% form 'new_comment', article %}
            {%- if form.errors -%}
              <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="form-success">Thanks for your comment{% if blog.moderated? %}, it will be reviewed before publishing{% endif %}.</p>
            {%- endif -%}
            <div class="form-row">
              <div class="form-group">
                <label for="CommentAuthor">Name <span>*</span></label>
                <input type="text" id="CommentAuthor" name="comment[author]" value="{{ form.author }}" required>
              </div>
              <div class="form-group">
                <label for="CommentEmail">Email <span>*</span></label>
                <input type="email" id="CommentEmail" name="comment[email]" value="{{ form.email }}" required>
              </div>
            </div>
            <div class="form-group">
              <label for="CommentBody">Comment <span>*</span></label>
              <textarea id="CommentBody" name="comment[body]" rows="5" required>{{ form.body }}</textarea>
            </div>
            <button type="submit" class="btn-primary">Post comment</button>
          {% endform %}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Article Page",
  "tag": "section",
  "class": "section-article",
  "settings": [
    {
      "type": "checkbox", "id": "show_author",
      "label": "Show author", "default": true
    },
    {
      "type": "checkbox", "id": "show_date",
      "label": "Show date", "default": true
    },
    {
      "type": "checkbox", "id": "show_tags",
      "label": "Show tags", "default": true
    },
    {
      "type": "checkbox", "id": "show_share_buttons",
      "label": "Show share buttons", "default": true
    },
    {
      "type": "checkbox", "id": "show_related",
      "label": "Show related articles", "default": true
    },
    {
      "type": "range", "id": "related_count",
      "label": "Related articles to show", "min": 1, "max": 6, "step": 1, "default": 3
    }
  ],
  "presets": [{ "name": "Article Page" }]
}
{% endschema %}
