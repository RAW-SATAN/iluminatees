{% comment %} All collections listing page {% endcomment %}

<div class="collections-list-page">
  <div class="collections-list-page__header">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep">/</span>
      <span class="breadcrumb__current">Collections</span>
    </nav>
    {%- if section.settings.heading != blank -%}
      <h1 class="collections-list-page__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
  </div>

  {%- assign cols_class = 'collections-list-page__grid--' | append: section.settings.columns -%}
  <div class="collections-list-page__grid {{ cols_class }}">
    {%- assign all_collections = collections -%}
    {%- if section.settings.sort == 'alphabetical' -%}
      {%- assign all_collections = collections | sort: 'title' -%}
    {%- endif -%}

    {%- for collection in all_collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="col-card">
          <div class="col-card__img-wrap" style="aspect-ratio:{{ section.settings.image_ratio }}">
            {%- if collection.image != blank -%}
              <img
                src="{{ collection.image | image_url: width: 600 }}"
                alt="{{ collection.image.alt | default: collection.title | escape }}"
                class="col-card__img"
                loading="lazy"
                width="{{ collection.image.width }}"
                height="{{ collection.image.height }}"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'col-card__placeholder' }}
            {%- endif -%}
            <div class="col-card__overlay">
              <h2 class="col-card__title">{{ collection.title }}</h2>
              {%- if section.settings.show_product_count -%}
                <p class="col-card__count">{{ collection.products_count }} products</p>
              {%- endif -%}
            </div>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections List",
  "tag": "section",
  "class": "section-list-collections",
  "settings": [
    {
      "type": "text", "id": "heading",
      "label": "Heading", "default": "All Collections"
    },
    {
      "type": "select", "id": "columns",
      "label": "Grid columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "select", "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "3/4",  "label": "Portrait (3:4)" },
        { "value": "1/1",  "label": "Square (1:1)" },
        { "value": "4/3",  "label": "Landscape (4:3)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "3/4"
    },
    {
      "type": "select", "id": "sort",
      "label": "Sort collections by",
      "options": [
        { "value": "alphabetical", "label": "A–Z" },
        { "value": "default",      "label": "Default (Shopify order)" }
      ],
      "default": "alphabetical"
    },
    {
      "type": "checkbox", "id": "show_product_count",
      "label": "Show product count", "default": true
    }
  ],
  "presets": [{ "name": "Collections List" }]
}
{% endschema %}
