{% comment %} Site Header {% endcomment %}

{%- assign menu = section.settings.menu | default: 'main-menu' -%}

{%- if section.settings.top_bar_text != blank -%}
<div class="site-header__topbar">
  <p class="site-header__topbar-text">{{ section.settings.top_bar_text }}</p>
</div>
{%- endif -%}

<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" id="SiteHeader">
  <div class="site-header__inner">

    {%- comment -%} Mobile hamburger {%- endcomment -%}
    <button class="site-header__burger" id="SiteHeaderBurger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    {%- comment -%} Logo {%- endcomment -%}
    <a href="/" class="site-header__logo-link" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          class="site-header__logo-img"
          width="{{ section.settings.logo_width | default: 120 }}"
          loading="eager"
        >
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Desktop nav {%- endcomment -%}
    <nav class="site-header__nav" aria-label="Main navigation">
      <ul class="site-header__nav-list">
        {%- for link in linklists[menu].links -%}
          {%- if link.links != blank -%}
            <li class="site-header__nav-item site-header__nav-item--has-drop">
              <a href="{{ link.url }}" class="site-header__nav-link">
                {{ link.title }}
                <svg class="site-header__nav-chevron" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
              <ul class="site-header__dropdown">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}" class="site-header__dropdown-link">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            </li>
          {%- else -%}
            <li class="site-header__nav-item">
              <a href="{{ link.url }}" class="site-header__nav-link{% if link.active %} is-active{% endif %}">{{ link.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Icons {%- endcomment -%}
    <div class="site-header__icons">
      {%- if section.settings.show_search -%}
        <a href="/search" class="site-header__icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="site-header__icon-btn" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="site-header__icon-btn site-header__cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="site-header__cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

  </div>
</header>

{%- comment -%} Mobile drawer nav {%- endcomment -%}
<div class="site-header__drawer" id="SiteHeaderDrawer" aria-hidden="true">
  <div class="site-header__drawer-inner">
    <button class="site-header__drawer-close" id="SiteHeaderDrawerClose" aria-label="Close menu">✕</button>
    <nav aria-label="Mobile navigation">
      <ul class="site-header__drawer-list">
        {%- for link in linklists[menu].links -%}
          <li class="site-header__drawer-item">
            <a href="{{ link.url }}" class="site-header__drawer-link">{{ link.title }}</a>
            {%- if link.links != blank -%}
              <ul class="site-header__drawer-sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}" class="site-header__drawer-sublink">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="site-header__drawer-footer">
      <a href="{{ routes.account_url }}">My Account</a>
      <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    </div>
  </div>
</div>
<div class="site-header__drawer-overlay" id="SiteHeaderOverlay"></div>

<script>
(function(){
  var burger  = document.getElementById('SiteHeaderBurger');
  var drawer  = document.getElementById('SiteHeaderDrawer');
  var overlay = document.getElementById('SiteHeaderOverlay');
  var closeBtn= document.getElementById('SiteHeaderDrawerClose');
  function open()  { drawer.classList.add('is-open'); overlay.classList.add('is-open'); burger.setAttribute('aria-expanded','true'); document.body.style.overflow='hidden'; }
  function close() { drawer.classList.remove('is-open'); overlay.classList.remove('is-open'); burger.setAttribute('aria-expanded','false'); document.body.style.overflow=''; }
  if(burger)  burger.addEventListener('click', open);
  if(closeBtn)closeBtn.addEventListener('click', close);
  if(overlay) overlay.addEventListener('click', close);
  {%- if section.settings.sticky -%}
  var header = document.getElementById('SiteHeader');
  window.addEventListener('scroll', function(){ header.classList.toggle('is-scrolled', window.scrollY > 60); }, { passive: true });
  {%- endif -%}
})();
</script>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo",         "label": "Logo image" },
    { "type": "range",        "id": "logo_width",   "label": "Logo width (px)", "min": 60, "max": 300, "step": 10, "default": 120 },
    { "type": "link_list",    "id": "menu",          "label": "Navigation menu", "default": "main-menu" },
    { "type": "text",         "id": "top_bar_text",  "label": "Top bar text", "default": "FREE SHIPPING on orders above ₹999 | Use code NEWPREMIUM for 20% off" },
    { "type": "checkbox",     "id": "sticky",        "label": "Sticky header",  "default": true },
    { "type": "checkbox",     "id": "show_search",   "label": "Show search icon","default": true },
    { "type": "checkbox",     "id": "show_account",  "label": "Show account icon","default": true }
  ]
}
{% endschema %}
