{% comment %} Customer single order detail page {% endcomment %}

<div class="order-page">
  <div class="order-page__inner">

    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep">/</span>
      <a href="{{ routes.account_url }}" class="breadcrumb__link">Account</a>
      <span class="breadcrumb__sep">/</span>
      <span class="breadcrumb__current">Order {{ order.name }}</span>
    </nav>

    <h1 class="order-page__title">Order {{ order.name }}</h1>
    <p class="order-page__date">Placed on {{ order.created_at | date: '%B %d, %Y' }}</p>

    <div class="order-page__grid">

      <div class="order-page__items">
        <h2 class="order-page__section-title">Items</h2>
        {%- for line_item in order.line_items -%}
          <div class="order-line">
            {%- if line_item.image != blank -%}
              <div class="order-line__img-wrap">
                <img src="{{ line_item.image | image_url: width: 120 }}" alt="{{ line_item.title | escape }}" class="order-line__img" loading="lazy">
              </div>
            {%- endif -%}
            <div class="order-line__info">
              <p class="order-line__name">
                <a href="{{ line_item.product.url }}">{{ line_item.title }}</a>
              </p>
              {%- unless line_item.variant.title == 'Default Title' -%}
                <p class="order-line__variant">{{ line_item.variant.title }}</p>
              {%- endunless -%}
              <p class="order-line__qty">Qty: {{ line_item.quantity }}</p>
              {%- if line_item.line_level_discount_allocations.size > 0 -%}
                {%- for discount in line_item.line_level_discount_allocations -%}
                  <p class="order-line__discount">{{ discount.discount_application.title }} (–{{ discount.amount | money }})</p>
                {%- endfor -%}
              {%- endif -%}
            </div>
            <div class="order-line__price">{{ line_item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="order-page__summary">
        <h2 class="order-page__section-title">Summary</h2>
        <div class="order-summary">
          <div class="order-summary__row">
            <span>Subtotal</span>
            <span>{{ order.subtotal_price | money }}</span>
          </div>
          {%- if order.cart_level_discount_applications.size > 0 -%}
            {%- for discount in order.cart_level_discount_applications -%}
              <div class="order-summary__row order-summary__row--discount">
                <span>{{ discount.title }}</span>
                <span>–{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
          {%- for shipping_method in order.shipping_methods -%}
            <div class="order-summary__row">
              <span>Shipping ({{ shipping_method.title }})</span>
              <span>{{ shipping_method.price | money }}</span>
            </div>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <div class="order-summary__row">
              <span>{{ tax_line.title }} ({{ tax_line.rate | times: 100 }}%)</span>
              <span>{{ tax_line.price | money }}</span>
            </div>
          {%- endfor -%}
          <div class="order-summary__row order-summary__row--total">
            <span>Total</span>
            <span>{{ order.total_price | money }}</span>
          </div>
        </div>

        <div class="order-page__addresses">
          <div class="order-address">
            <h3>Billing address</h3>
            <address>{{ order.billing_address | format_address }}</address>
          </div>
          {%- if order.shipping_address -%}
            <div class="order-address">
              <h3>Shipping address</h3>
              <address>{{ order.shipping_address | format_address }}</address>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>

    <a href="{{ routes.account_url }}" class="order-page__back">← Back to account</a>

  </div>
</div>

{% schema %}
{
  "name": "Customer Order",
  "tag": "section",
  "class": "section-customer-order",
  "settings": [],
  "presets": [{ "name": "Customer Order" }]
}
{% endschema %}
