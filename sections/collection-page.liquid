{% comment %} Collection page — filter sidebar + product grid {% endcomment %}

{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}

<div class="col-page">

  {%- comment -%} Breadcrumb {%- endcomment -%}
  <nav class="breadcrumb" aria-label="breadcrumb">
    <a href="/" class="breadcrumb__link">Home</a>
    <span class="breadcrumb__sep">/</span>
    <span class="breadcrumb__current">{{ collection.title }}</span>
  </nav>

  <h1 class="col-page__title">{{ collection.title }}</h1>

  {%- paginate collection.products by section.settings.products_per_page -%}

  <div class="col-page__body">

    {%- comment -%} Sidebar {%- endcomment -%}
    <aside class="col-page__sidebar{% if section.settings.sticky_sidebar %} col-page__sidebar--sticky{% endif %}" aria-label="Filters">
      <h2 class="col-page__sidebar-title">FILTER BY</h2>

      {%- for filter in collection.filters -%}
        <div class="filter-group">
          <button class="filter-group__toggle" aria-expanded="true" aria-controls="Filter-{{ forloop.index }}">
            {{ filter.label }}
            <svg class="filter-group__chevron" viewBox="0 0 16 10" fill="none"><path d="M1 1l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="filter-group__body" id="Filter-{{ forloop.index }}">
            {%- if filter.type == 'list' -%}
              <ul class="filter-group__list">
                {%- for value in filter.values -%}
                  <li class="filter-group__item">
                    <label class="filter-group__label">
                      <input
                        type="checkbox"
                        class="filter-group__checkbox"
                        {% if value.active %}checked{% endif %}
                        data-filter-url="{{ value.url_to_add }}"
                        data-filter-remove="{{ value.url_to_remove }}"
                      >
                      <span class="filter-group__check-custom"></span>
                      {{ value.label }}
                      {%- if section.settings.show_filter_count -%}
                        <span class="filter-group__count">({{ value.count }})</span>
                      {%- endif -%}
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
            {%- elsif filter.type == 'price_range' -%}
              <div class="filter-group__price">
                <input type="number" placeholder="Min" class="filter-group__price-input"
                  value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                  min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}">
                <span class="filter-group__price-sep">–</span>
                <input type="number" placeholder="Max" class="filter-group__price-input"
                  value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                  min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}">
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        {%- comment -%} Placeholder filters when no filters configured {%- endcomment -%}
        {%- assign placeholder_filters = 'Category,Size,Color,Price,Brand' | split: ',' -%}
        {%- for f in placeholder_filters -%}
          <div class="filter-group">
            <button class="filter-group__toggle" aria-expanded="true">
              {{ f }}
              <svg class="filter-group__chevron" viewBox="0 0 16 10" fill="none"><path d="M1 1l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </aside>

    {%- comment -%} Main content {%- endcomment -%}
    <div class="col-page__main">

      {%- comment -%} Toolbar {%- endcomment -%}
      <div class="col-page__toolbar">
        <p class="col-page__count">
          <strong>{{ collection.products_count }}</strong> products
        </p>

        <div class="col-page__toolbar-right">
          {%- comment -%} Grid toggle {%- endcomment -%}
          <div class="col-page__grid-toggle">
            <span class="col-page__grid-label">VIEW</span>
            {%- for cols in '2,3,4' | split: ',' -%}
              {%- assign cols_int = cols | plus: 0 -%}
              <button class="col-page__grid-btn{% if forloop.index == 2 %} is-active{% endif %}" data-cols="{{ cols }}" aria-label="{{ cols }} columns">
                {%- for i in (1..cols_int) -%}<span class="col-page__grid-bar"></span>{%- endfor -%}
              </button>
            {%- endfor -%}
          </div>

          {%- comment -%} Sort {%- endcomment -%}
          <div class="col-page__sort">
            <label class="col-page__sort-label" for="ColSort">SORT</label>
            <div class="col-page__sort-wrap">
              <select id="ColSort" class="col-page__sort-select" aria-label="Sort by">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
              <svg class="col-page__sort-chevron" viewBox="0 0 16 10" fill="none"><path d="M1 1l7 7 7-7" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} Active filters {%- endcomment -%}
      {%- assign active_filters_count = 0 -%}
      {%- for filter in collection.filters -%}
        {%- assign active_filters_count = active_filters_count | plus: filter.active_values.size -%}
      {%- endfor -%}
      {%- if active_filters_count > 0 -%}
        <div class="col-page__active-filters">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}" class="col-page__active-tag">
                {{ value.label }} <span>✕</span>
              </a>
            {%- endfor -%}
          {%- endfor -%}
          <a href="{{ collection.url }}" class="col-page__clear-all">Clear all</a>
        </div>
      {%- endif -%}

      {%- comment -%} Product grid {%- endcomment -%}
      <div class="col-page__grid" id="ColProductGrid" data-cols="{{ section.settings.default_columns | default: 3 }}">
        {%- for product in collection.products -%}
          <div class="prod-card">
            <div class="prod-card__img-wrap" style="aspect-ratio:{{ section.settings.image_ratio | default: '3/4' }}">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  class="prod-card__img"
                  loading="{% if forloop.index <= 6 %}eager{% else %}lazy{% endif %}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'prod-card__placeholder' }}
              {%- endif -%}

              {%- if product.tags contains 'BESTSELLER' or product.tags contains 'bestseller' -%}
                <span class="prod-card__badge prod-card__badge--bestseller">BESTSELLER</span>
              {%- elsif product.tags contains 'EXCLUSIVE' or product.tags contains 'exclusive' -%}
                <span class="prod-card__badge prod-card__badge--exclusive">EXCLUSIVE</span>
              {%- elsif product.tags contains 'NEW' or product.compare_at_price > product.price -%}
                <span class="prod-card__badge prod-card__badge--new">{% if product.tags contains 'NEW' %}NEW{% else %}SALE{% endif %}</span>
              {%- endif -%}

              <button class="prod-card__wish" aria-label="Add to wishlist">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>
            </div>

            <div class="prod-card__info">
              <p class="prod-card__brand">{{ product.vendor | upcase }}</p>
              <a href="{{ product.url }}" class="prod-card__name">{{ product.title }}</a>
              <div class="prod-card__pricing">
                {%- if product.compare_at_price > product.price -%}
                  <span class="prod-card__price">{{ product.price | money }}</span>
                  <span class="prod-card__compare">{{ product.compare_at_price | money }}</span>
                  <span class="prod-card__discount">({{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% off)</span>
                {%- else -%}
                  <span class="prod-card__price">{{ product.price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="col-page__empty">
            <p>No products found. <a href="{{ collection.url }}">Clear filters</a></p>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Pagination {%- endcomment -%}
      {%- if paginate.pages > 1 -%}
        <div class="col-page__pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">← Prev</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="current">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">Next →</a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>

  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection Page",
  "tag": "section",
  "class": "section-collection-page",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12, "max": 48, "step": 4, "default": 24
    },
    {
      "type": "select",
      "id": "default_columns",
      "label": "Default grid columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns (recommended)" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        { "value": "1/1",  "label": "Square (1:1)" },
        { "value": "3/4",  "label": "Portrait (3:4) — recommended" },
        { "value": "4/5",  "label": "Portrait (4:5)" },
        { "value": "4/3",  "label": "Landscape (4:3)" }
      ],
      "default": "3/4"
    },
    {
      "type": "checkbox",
      "id": "show_filter_count",
      "label": "Show filter counts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_sidebar",
      "label": "Sticky filter sidebar",
      "default": true
    }
  ],
  "presets": [{ "name": "Collection Page" }]
}
{% endschema %}
