generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id        String   @id
  customer  String
  phone     String
  address   String
  city      String
  items     Json
  total     Float
  status    String   @default("pending")
  payment   String   @default("unpaid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSetting {
  key   String @id
  value String
}
